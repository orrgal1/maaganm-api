# Gmail command-bus worker configuration

# Required: provision from the approved vault; never commit or place in email payloads.
MAAGANM_EMAIL_HMAC_SECRET=

# Exact mailbox identities used by the command bus.
MAAGANM_EMAIL_ALIAS=orrgal+agents+maaganm@gmail.com
MAAGANM_EMAIL_SENDER=orgal@mail.instinct.com
MAAGANM_EMAIL_LABEL_ID=Label_35
MAAGANM_EMAIL_LABEL_NAME=Agents
GAPI_MAX_OUTPUT_BYTES=8388608
MAAGANM_EMAIL_DB_PATH=maaganm_email.sqlite3
MAAGANM_EMAIL_POLL_SECONDS=30
GAPI_BIN=gapi

# Local budget portal credentials. Keep values blank here and set them only locally.
BUDGET_USERNAME=
BUDGET_PASSWORD=
BUDGET_BASE_URL=https://budget.mmm.org.il/

# Local help portal configuration. Provision HELP_MEMBER_ID locally; leave it blank here.
HELP_MEMBER_ID=
HELP_BASE_URL=https://help.mmm.org.il

# Local operation settings.
HEADLESS=true
MOCK_MODE=false
