# Maagan Michael Budget Local API Wrapper Configuration

# API Bearer token for access (generate with generate_token.py or set a fixed token)
MAAGANM_API_TOKEN=change_me_to_a_long_random_secret_token

# Optional: Default caller credentials (if not passed per-request via X-Budget-Username / X-Budget-Password)
# Store your actual credentials in .env.local (do NOT commit .env.local)
BUDGET_USERNAME=
BUDGET_PASSWORD=

# Local server binding
HOST=127.0.0.1
PORT=8001

# Operating mode
MOCK_MODE=false
HEADLESS=true
